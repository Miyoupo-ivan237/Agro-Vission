{
  "name": "agrovission-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node ./node_modules/expo/bin/cli start --clear --lan --port 8082",
    "start-offline": "node ./node_modules/expo/bin/cli start --offline --clear --port 8082",
    "start-usb": "node ./node_modules/expo/bin/cli start --localhost --clear --port 8082",
    "start-tunnel": "node ./node_modules/expo/bin/cli start --tunnel --clear",
    "android": "node ./node_modules/expo/bin/cli run:android",
    "ios": "node ./node_modules/expo/bin/cli run:ios",
    "web": "node ./node_modules/expo/bin/cli start --web --clear --port 8082"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "json5": "2.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "twrnc": "^4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/cli": "^57.0.23",
    "babel-preset-expo": "~57.0.0"
  }
}
